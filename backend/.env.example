# Server Configuration
PORT=5000
NODE_ENV=development

# Razorpay API Credentials (Get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# MongoDB Connection String (Atlas URI or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/razorpay_demo

# Frontend Client URL for CORS (e.g., http://localhost:5173 or https://your-frontend.vercel.app)
CLIENT_URL=http://localhost:5173
